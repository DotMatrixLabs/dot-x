# Copy to .env and fill in the values used by your build.
DOTX_SENTRY_DSN=
DOTX_APTABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STATS_SECRET_KEY=
VITE_MARKETPLACE_REGISTRY_URL=https://dotmatrixlabs.github.io/dot-x-plugins/marketplace-registry.json
# In-app feedback. Create the app key in the Veerify dashboard under Product settings → API keys.
# It can only create feedback, so shipping it inside the app is fine.
VITE_VEERIFY_API_URL=
VITE_VEERIFY_APP_KEY=
