# Dot X environment configuration.
# Copy this file to .env and fill in the values you need:
#
#   cp .env.example .env
#
# Empty or missing values disable the related feature without breaking the build.
# .env is gitignored, so local values never get committed.

# Rust side, read at compile time by src-tauri/build.rs.

# Sentry crash-reporting DSN, format: https://<public-key>@<ingest-host>/<project-id>
# Leave empty to disable crash reporting.
DOTX_SENTRY_DSN=

# Aptabase product-analytics app key, format: A-EU-0000000000
# Leave empty to disable analytics.
DOTX_APTABASE_KEY=

# Frontend side, read by Vite at build time. Only VITE_* names reach the app.

# Supabase project backing marketplace like/download counts.
# Leave empty to disable marketplace stats.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Obfuscation key for the local slider-distance stat.
# Changing it makes previously stored values unreadable and resets the counter.
VITE_STATS_SECRET_KEY=

# Marketplace registry URL override. Empty uses the default registry.
VITE_MARKETPLACE_REGISTRY_URL=
