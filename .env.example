# Copy to .env and fill in the values used by your build.
# Leave optional values empty for a contributor build.

# Crash reporting endpoint. Empty disables Sentry initialization.
DOTX_SENTRY_DSN=
# Usage analytics app key. Empty disables Aptabase initialization.
DOTX_APTABASE_KEY=
# Marketplace statistics project and public anon key. Set both to enable it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local slider-distance stat obfuscation, not a credential or security boundary.
VITE_STATS_SECRET_KEY=
# Public marketplace index. The app also has this default built in.
VITE_MARKETPLACE_REGISTRY_URL=https://dotmatrixlabs.github.io/dot-x-plugins/marketplace-registry.json
