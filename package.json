{
  "name": "dot-x",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:linux": "node scripts/dev-linux.mjs",
    "setup:linux": "bash scripts/install-linux-deps.sh",
    "build": "npm run check:capabilities && npm run licenses && npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --dir src",
    "tauri": "tauri",
    "fetch-deno": "node tools/fetch-deno.mjs",
    "licenses": "npm run rust-licenses && npm run js-licenses",
    "rust-licenses": "cd src-tauri && cargo license --avoid-dev-deps --avoid-build-deps --json > licenses/rust_licenses.json",
    "js-licenses": "npx npm-license-crawler --json src-tauri/licenses/js_licenses.json",
    "generate-types": "tsx tools/generate-plugin-types.ts",
    "check:capabilities": "node tools/check-desktop-capabilities.mjs",
    "bump": "node tools/bump-version.mjs",
    "folder": "node tools/folder.mjs",
    "fix-name": "node tools/fix-name.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@tauri-apps/api": "2.9.0",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-fs": "2.4.4",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.3",
    "@tauri-apps/plugin-store": "2.4.1",
    "@tauri-apps/plugin-updater": "2.9.0",
    "@tauri-apps/plugin-websocket": "2.4.1",
    "@types/lodash": "^4.14.200",
    "@types/socket.io": "^3.0.2",
    "@vuepic/vue-datepicker": "^7.4.0",
    "crypto-js": "^4.2.0",
    "image-dimensions": "^2.3.0",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "mitt": "^3.0.1",
    "npm-license-crawler": "^0.2.1",
    "pinia": "^2.1.7",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "vue": "^3.3.4",
    "vue-slicksort": "^2.0.0",
    "vue-sonner": "^2.0.9",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.9.2",
    "@types/crypto-js": "^4.2.1",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "6.0.0",
    "@vue/devtools": "8.0.2",
    "autoprefixer": "^10.4.16",
    "daisyui": "^3.9.3",
    "esbuild": "^0.25.6",
    "license-checker": "^25.0.1",
    "postcss": "^8.4.31",
    "sass": "^1.69.5",
    "supabase": "^2.78.1",
    "tailwindcss": "^3.3.3",
    "ts-morph": "^26.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.2",
    "vite": "^6",
    "vitest": "^3.2.4",
    "vue-tsc": "^1.8.5"
  },
  "resolutions": {
    "**/license-checker": "25.0.1"
  }
}
