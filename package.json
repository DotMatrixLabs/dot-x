{
  "name": "dot-x",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run licenses && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "licenses": "npm run rust-licenses && npm run js-licenses",
    "rust-licenses": "cd src-tauri && cargo license --avoid-dev-deps --avoid-build-deps --json > licenses/rust_licenses.json",
    "js-licenses": "npx npm-license-crawler --json src-tauri/licenses/js_licenses.json"
  },
  "dependencies": {
    "@aptabase/tauri": "^0.4.1",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@tauri-apps/api": ">=2.0.0",
    "@types/node": "^22.10.2",
    "@types/lodash": "^4.14.200",
    "crypto-js": "^4.2.0",
    "image-dimensions": "^2.3.0",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "npm-license-crawler": "^0.2.1",
    "pinia": "^2.1.7",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tauri-plugin-autostart-api": "https://github.com/tauri-apps/tauri-plugin-autostart#v1",
    "tauri-plugin-store-api": "https://github.com/tauri-apps/tauri-plugin-store#v1",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vue-toastification": "^2.0.0-rc.5",
    "vue-virtual-scroller": "^2.0.0-beta.8"
