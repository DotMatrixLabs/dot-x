{
  "id": "system-control",
  "name": "System Control Plugin",
  "version": "1.0.0",
  "description": "A comprehensive example plugin that demonstrates all available features",
  "author": "DotX Team",
  "dotxVersion": ">=1.0.0",
  "main": "main.ts",
  "permissions": [
    "ui.modal",
    "ui.toasts",
    "ui.commands",
    "ui.settings",
    "ui.actionSelector",
