{
  "name": "dotx-plugin-sdk",
  "version": "1.0.0",
  "description": "SDK for developing Dot X plugins",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "create-dotx-plugin": "./bin/create-dotx-plugin.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "docs:clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force 'D:/dotmatrixlabs-docs/docs/plugin-sdk/reference' -ErrorAction SilentlyContinue\"",
    "docs:build": "yarn run docs:clean && typedoc --options ./typedoc.json --out \"D:/dotmatrixlabs-docs/docs/plugin-sdk/reference\" && node ./scripts/split-docs.mjs \"D:/dotmatrixlabs-docs/docs/plugin-sdk/reference\"",
    "docs:watch": "typedoc --options ./typedoc.json --out \"D:/dotmatrixlabs-docs/docs/plugin-sdk/reference\" --watch"
  },
  "dependencies": {
    "conf": "^14.0.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/socket.io-client": "^3.0.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.7.0"
  }
}
