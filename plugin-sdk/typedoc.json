{
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "categorizeByGroup": true,
  "outputFileStrategy": "modules",
  "groupOrder": [
    "Plugin Lifecycle",
    "Settings Page",
    "Action Mapper Modal",
    "Global UI",
    "Storing Data",
    "Advanced/Internal",
    "*"
  ],
  "categoryOrder": ["UI", "Runtime", "Communication", "Manifest", "Other"],
  "hideBreadcrumbs": true,
  "indexFormat": "table",
  "exclude": [
    "**/*.{test,spec}.ts",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "excludeInternal": false,
  "skipErrorChecking": true
}

