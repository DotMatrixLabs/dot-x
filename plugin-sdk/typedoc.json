{
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "readme": "none",
  "categorizeByGroup": false,
  "categoryOrder": [
    "Plugin Lifecycle",
    "Settings Page",
    "Action Mapper Modal",
    "Global UI",
    "Storing Data",
    "Advanced/Internal",
    "*"
  ],
  "exclude": [
    "**/*.{test,spec}.ts",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "excludeInternal": false,
  "skipErrorChecking": true,
  "disableSources": true,
  "blockTags": [
    "@displayName",
    "@related",
    "@category"
  ]
}

