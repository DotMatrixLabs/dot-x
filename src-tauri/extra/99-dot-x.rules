# Dot X — grant the logged-in seat user access to USB serial devices
# without requiring group membership (systemd uaccess via logind ACL).
#
# Covers USB CDC ACM (ttyACM*) and USB-to-serial adapters (ttyUSB*) so
# both official Decker hardware and DIY devices work out of the box.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", TAG+="uaccess"
SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", TAG+="uaccess"
