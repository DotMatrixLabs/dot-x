{
  "productName": "Dot X",
  "mainBinaryName": "Dot X",
  "version": "2.0.0-beta.20261105092909.1",
  "identifier": "com.dot-x.dev",
  "build": {
    "beforeBuildCommand": "yarn fetch-deno && yarn build",
    "beforeDevCommand": "yarn fetch-deno && yarn dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QzAxNzlDNjE2NzNFMQpSV1RoY3hiR2VRRmNDT295eUJ1eXdLL2NTb2xCT2pRR1E4VmZzdTN5OS81bmZGMDJBUWZsSUtWUQo=",
      "endpoints": [
        "https://github.com/DotMatrixLabs/dot-x/releases/latest/download/latest.json"
      ]
    },
    "cli": {
      "description": "",
      "longDescription": "",
      "beforeHelp": "",
      "afterHelp": "",
      "args": [
        {
          "name": "hidden",
          "short": "H"
        }
      ],
      "subcommands": {}
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "licenseFile": "licenses/GPL-3.0.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2025 Frogbyte AS",
    "category": "Utility",
    "shortDescription": "Dot X",
    "longDescription": "Desktop app for DotMatrixLabs products",
    "resources": [
      "licenses/*",
      "resources/deno/deno-x86_64-pc-windows-msvc.zip"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "./icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "headerImage": "./icons/NSISInstallerBanner.bmp",
        "sidebarImage": "./icons/NSISInstaller.bmp"
      }
    },
    "createUpdaterArtifacts": "v1Compatible",
    "fileAssociations": [
      {
        "ext": [
          "dotxplugin"
        ],
        "name": "Dot X Plugin",
        "description": "Dot X Plugin Package"
      }
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 600,
        "resizable": false,
        "title": "Dot X",
        "width": 800,
        "minWidth": 750,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "useHttpsScheme": true
      }
    ]
  }
}
