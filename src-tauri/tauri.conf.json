{
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Dot X",
    "version": "1.0.0"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.dot-x.dev",
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fileDropEnabled": false,
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Dot X",
        "width": 800,
        "minWidth": 750,
        "transparent": true,
        "decorations": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": true,
      "endpoints": [
          "https://dist.anystack.sh/v1/tauri/PRODUCT-ID/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "REDACTED_UPDATER_PRIVATE_KEY"
    },
    "allowlist": {
      "notification": {
        "all": true
      },
      "window": {
        "all": true
      },
      "os": {
        "all": true
      }
    }
  }
}