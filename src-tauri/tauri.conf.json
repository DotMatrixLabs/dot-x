{
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Dot X",
    "version": "1.0.7"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.dot-x.dev",
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "copyright": "Copyright © 2024 Frogbyte AS",
      "category": "Utility",
      "shortDescription": "Desktop app for DotMatrixLabs products",
      "longDescription": "Dot X is a desktop app for managing products made by DotMatrixLabs, as well as other compatible devices. More info at https://dotmatrixlabs.com",
      "resources": [
        "license.txt"
      ],
      "windows": {
        "nsis": {
          "license": "license.txt"
        },
        "wix": {
          "license": "license.txt"
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fileDropEnabled": false,
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Dot X",
        "width": 800,
        "minWidth": 750,
        "transparent": true,
        "decorations": false,
        "visible": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://dist.anystack.sh/v1/tauri/9ab29103-730b-453d-b1c2-e7b57d099d07/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2QzVDQUYzNDVERjJDNzEKUldSeExOOUY4OHJGVm5PNnZHQlZPRWE4WERodmxBYkpYbzluS2V0czlhZjRqWm5QWkRqNUt5b0cK"
    },
    "allowlist": {
      "notification": {
        "all": true
      },
      "window": {
        "all": true
      },
      "os": {
        "all": true
      }
    },
    "cli": {
      "description": "",
      "longDescription": "",
      "beforeHelp": "",
      "afterHelp": "",
      "args": [
        {
          "name": "hidden",
          "short": "h"
        }
      ],
      "subcommands": {}
    }
  }
}
