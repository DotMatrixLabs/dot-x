{
  "productName": "Dot X",
  "mainBinaryName": "Dot X",
  "version": "2.0.0-1",
  "identifier": "com.dot-x.dev",
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2QzVDQUYzNDVERjJDNzEKUldSeExOOUY4OHJGVm5PNnZHQlZPRWE4WERodmxBYkpYbzluS2V0czlhZjRqWm5QWkRqNUt5b0cK",
      "endpoints": [
        "https://dist.anystack.sh/v1/tauri/9ab29103-730b-453d-b1c2-e7b57d099d07/{{current_version}}"
      ]
    },
    "cli": {
      "description": "",
      "longDescription": "",
      "beforeHelp": "",
      "afterHelp": "",
      "args": [
        {
          "name": "hidden",
          "short": "H"
        }
      ],
      "subcommands": {}
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "licenses/EULA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2025 Frogbyte AS",
    "category": "Utility",
    "shortDescription": "Dot X",
    "longDescription": "Desktop app for DotMatrixLabs products",
    "resources": [
      "licenses/*",
      "resources/deno/*"
    ],
    "windows": {
      "certificateThumbprint": "ca2e93b1a72064b5c3ecdef2481044859fbe241b",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://time.certum.pl",
      "nsis": {
        "installerIcon": "./icons/icon.ico"
      },
      "wix": {
        "bannerPath": "./icons/WixInstallerBanner.bmp",
        "dialogImagePath": "./icons/WixInstaller.bmp"
      }
    },
    "createUpdaterArtifacts": "v1Compatible",
    "fileAssociations": [
      {
        "ext": ["dotxplugin"],
        "name": "Dot X Plugin",
        "description": "Dot X Plugin Package"
      }
    ]
  },
  

  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Dot X",
        "width": 800,
        "minWidth": 750,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "useHttpsScheme": true
      }
    ]
    
  }
}